# Server
server <- function(input, output) {
  
  output$grafico <- renderPlotly({
    
    colores <- setNames(
      brewer.pal(length(series_precios), "Dark2"),
      series_precios
    )
    titulo_yaxis <- case_when(
      input$grupo == "crudo" ~ "Dólares por barril (US$)",
      input$grupo == "refin" ~ "Centavos por galón (USd)",
      TRUE ~ "Dólares por millón de BTU (US$)"
      )
    filtrado <- precios %>%
      filter(Fecha >= max(Fecha) - years(as.numeric(input$intervalo)))
    
    if (input$grupo == "crudo") {
      procesado <- filtrado %>%
        filter(Serie %in% series_precios[1:2])
    } else if (input$grupo == "refin") {
      procesado <- filtrado %>%
        filter(Serie %in% series_precios[3:4]) %>%
        mutate(Valor = Valor * 1e2)
    } else {
        procesado <- filtrado %>%
          filter(Serie %in% series_precios[5:6])
        }
    
    plot_ly(
      procesado,
      x=~Fecha,
      y=~Valor,
      color=~Serie,
      colors=colores,
      type="scatter",
      mode="lines",
      hovertemplate="%{fullData.name}: %{y:,.1f}<extra></extra>"
      ) %>%
      plotly::layout(
        dragmode = FALSE,
        hovermode = "x unified",
        hoverlabel = list(bgcolor = "white"),
        legend = list(
          orientation = "h",
          y = 1.2, x = 0
          ),
        yaxis = list(
          title = titulo_yaxis,
          tickformat = ",.0f"
          ),
        xaxis = list(title = ""),
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)"
      ) %>%
      plotly::config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE,
        locale = "es"
      )
  })
}

shinyApp(ui, server)