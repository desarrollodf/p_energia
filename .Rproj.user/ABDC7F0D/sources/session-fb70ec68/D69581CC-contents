library(RColorBrewer)
library(shinyWidgets)
library(shinyBS)

series_precios <- c(
  "Crudo Brent", "Crudo WTI",
  "Gasolina RBOB", "Diésel ULSD",
  "Gas natural HH", "Gas natural TTF"
)

precios <- read_xlsx("energia.xlsx", sheet="Hoja1") %>%
  slice(-1) %>%
  na.omit() %>%
  setNames(c("Fecha", series_precios)) %>%
  mutate(Fecha = as.Date(as.numeric(Fecha), origin = "1899-12-30")) %>%
  pivot_longer(cols = -Fecha, values_to = "Valor", names_to = "Serie") %>%
  mutate(
    Valor = as.numeric(Valor),
    Valor = ifelse(Serie == "Gas natural TTF", Valor / 3.412141633, Valor),
    Serie = factor(Serie, levels=series_precios)
    )

