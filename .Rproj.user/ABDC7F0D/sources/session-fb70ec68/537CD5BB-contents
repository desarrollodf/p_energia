series_precios <- c(
  "Brent", "WTI",
  "Gas natural HH", "Gas natural TTF",
  "Gasóleo", "Gasolina", "Diésel"
)

precios <- read_xlsx("datos.xlsx", sheet="Hoja1") %>%
  slice(-1) %>%
  na.omit() %>%
  setNames(c("Fecha", series_precios)) %>%
  mutate(Fecha = as.Date(as.numeric(Fecha), origin = "1900-01-01")) %>%
  pivot_longer(cols = -Fecha, values_to = "Valor", names_to = "Serie") %>%
  mutate(
    Valor = as.numeric(Valor),
    Serie = factor(Serie, levels=series_precios)
    ) %>%
  filter(Fecha >= max(Fecha) - years(2))

fecha_lastyr <- precios %>%
  arrange(Fecha) %>%
  mutate(Anho = year(Fecha)) %>%
  filter(Anho == max(Anho) - 1) %>%
  reframe(Fecha = last(Fecha)) %>%
  pull(Fecha)

