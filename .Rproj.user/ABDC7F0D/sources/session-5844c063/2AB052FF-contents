server <- function(input, output) {
  
  output$grafico <- renderPlotly({
    
    filtrado <- divisas %>%
        filter(Medicion == input$medicion) %>%
        arrange(desc(Retorno))
    
    top <- filtrado %>% slice_head(n = 7)
    sub <- filtrado %>% slice_tail(n = 7)
    combinado <- bind_rows(top, sub)
    
    paleta <- colorRampPalette(c("steelblue", "white", "red"))(nrow(combinado))
    combinado$color <- paleta
    
      plot_ly(
        combinado,
        x = ~Retorno,
        y = ~reorder(Divisa, Retorno),
        type = "bar",
        textposition = "none",
        showlegend = FALSE,
        marker = list(color = combinado$color),
        customdata = ~Name,
        hovertemplate = "%{customdata}: %{x:.1f}%<extra></extra>"
      ) %>%
        plotly::layout(
          hovermode = "y unified",
          hoverlabel = list(bgcolor = "white"),
          dragmode = FALSE,
          yaxis = list(title = ""),
          xaxis = list(title = "Retorno % año en curso"),
          paper_bgcolor = "rgba(0,0,0,0)",
          plot_bgcolor = "rgba(0,0,0,0)",
          shapes = list(
          list(
            type = "line",
            xref = "paper",
            x0 = 0,
            x1 = 1,
            yref = "y",
            y0 = nrow(combinado) / 2 - 0.5,
            y1 = nrow(combinado) / 2 - 0.5,
            line = list(color = "grey", width = 2)
          )
        )
      ) %>%
        plotly::config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE,
        locale = "es"
      )
  })
}

shinyApp(ui, server)