library(shiny)
library(readxl)
library(dplyr)
library(tidyverse)
library(zoo)
library(ggplot2)
library(plotly)
library(scales)
library(lubridate)
library(rsconnect)
library(shinyWidgets)
library(shinyBS)

divisas_spot <- read_xlsx("ranking_divisas.xlsx", sheet = "spot") %>%
  mutate(Divisa = substr(Ticker, 1, 3)) %>%
  rename(Spot = YTD)

divisas_carry_bruto <- read_xlsx("ranking_divisas.xlsx", sheet = "interes")

columnas_carry <- names(divisas_carry_bruto)[-1]
divisas_carry <- divisas_carry_bruto %>% slice_tail(n = -2) %>%
  setNames(c("Fecha", columnas_carry)) %>%
  mutate(Fecha = as.Date(as.numeric(Fecha), origin = "1899-12-30")) %>%
  pivot_longer(cols = -Fecha, values_to = "Valor", names_to = "Divisa") %>%
  mutate(Valor = as.numeric(Valor)) %>%
  group_by(Divisa) %>%
  reframe(Interes = (last(Valor) / first(Valor) - 1) * 100) %>%
  mutate(Divisa = substr(Divisa, 1, 3))

divisas = left_join(divisas_spot, divisas_carry, by = "Divisa") %>%
  select(Divisa, Spot, Interes) %>%
  mutate(Total = Spot + Interes) %>%
  pivot_longer(cols = -Divisa, values_to = "Retorno", names_to = "Medicion") %>%
  left_join(divisas_spot %>% select(Name, Divisa), by = "Divisa") %>%
  na.omit() %>%
  mutate(
    Name = gsub(" Spot", "", Name, fixed = TRUE),
    Name = gsub("SPOT (TOM)", "", Name, fixed = TRUE),
    )

