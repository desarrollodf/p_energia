library(shiny)
library(readxl)
library(dplyr)
library(tidyverse)
library(zoo)
library(ggplot2)
library(plotly)
library(scales)
library(lubridate)
library(rsconnect)
library(rlang)
library(shinyWidgets)
library(shinyBS)
accion_bruto <- read_xlsx('accion.xlsx')
primer_ipsa <- accion_bruto %>%
filter(
Serie == 'IPSA',
Fecha == first(Fecha)
) %>%
pull(Fecha)
ticker_accion <- accion_bruto %>%
filter(Serie != 'IPSA') %>%
pull(Serie) %>%
unique()
nombre_accion <- 'Falabella'
accion <- accion_bruto %>%
filter(Fecha >= primer_ipsa) %>%
mutate(
Serie = ifelse(Serie == ticker_accion, nombre_accion, Serie)
)
View(accion)
